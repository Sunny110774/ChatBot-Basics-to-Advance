# Copy this file to ".env" (or let run_windows.bat create it) and fill in your values.
# Never share or upload your .env file.
ANTHROPIC_API_KEY=sk-ant-...
# Only needed if your key was NOT created inside a workspace (starts with wrkspc_)
ANTHROPIC_WORKSPACE_ID=
# Optional: claude-sonnet-5-5 (default), claude-opus-5-5, claude-haiku-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
